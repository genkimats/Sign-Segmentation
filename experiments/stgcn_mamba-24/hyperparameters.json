{
    "batch_size": 16,
    "epochs": 30,
    "learning_rate": 0.0001,
    "window_size": 512,
    "overlap": 200,
    "num_vertices": 65,
    "tolerance_window": 1,
    "use_full_length": false,
    "base_features": [
        "x-cord",
        "y-cord"
    ],
    "kinematic_features": [
        "velocity",
        "acceleration",
        "jerk"
    ],
    "in_channels": 8,
    "loss_function": "standard_ce",
    "decoder_strategy": "threshold",
    "decoder_threshold": 0.5,
    "d_model": 256,
    "n_layers": 4,
    "focal_loss_gamma": 2.0,
    "optimizer": "AdamW",
    "scheduler": "CosineAnnealingLR",
    "basename": "stgcn_mamba",
    "description": "cords v a j"
}