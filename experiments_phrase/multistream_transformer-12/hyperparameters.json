{
    "basename": "multistream_transformer",
    "window_size": 128,
    "overlap": 0,
    "batch_size": 16,
    "epochs": 100,
    "early_stopping": true,
    "patience": 10,
    "learning_rate": 0.0001,
    "num_vertices": 65,
    "tolerance_window": 1,
    "temporal_downsample_factor": 1,
    "loss_function": "weighted_ce",
    "ctc_weight": 0.5,
    "class_weights": [
        1.0,
        1.1,
        12.4
    ],
    "tmse_weight": 0.15,
    "tmse_threshold": 0.1,
    "base_features": [
        "x-cord",
        "y-cord",
        "z-cord"
    ],
    "kinematic_features": [],
    "in_channels": 3,
    "use_face_keypoints": false,
    "face_dir": "processed_data/face_keypoints_normalized",
    "face_subset": "full",
    "face_only": false,
    "use_hamer_features": true,
    "hamer_dir": "processed_data/hamer_features",
    "stgcn_proj_dim": null,
    "use_stream_body_hands": true,
    "use_stream_face": false,
    "use_stream_hamer": true,
    "fusion": "concat",
    "pos_encoding": "none",
    "transformer_norm": "pre",
    "rope_base": 10000.0,
    "nhead": 8,
    "body_hands_proj_dim": 256,
    "face_proj_dim": 256,
    "use_dinov2_features": false,
    "dinov2_dir": "processed_data/dinov2_features",
    "d_model": 256,
    "n_layers": 4,
    "mamba_d_state": 16,
    "mamba_d_conv": 4,
    "mamba_expand": 2,
    "optimizer": "AdamW",
    "scheduler": "CosineAnnealingLR",
    "description": "PE study: Body+HaMeR, Transformer pre-norm, pos=none, window 128",
    "prefix": "12",
    "selection_metric": "frame_f1"
}